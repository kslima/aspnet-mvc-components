@using AntDesign
@using Pms.Components.Pages.Emissores.Models


<div class="container-fluid p-3">

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6">
            <label class="form-label d-block fw-semibold" style="font-size: 12px; margin-bottom: 4px;">Nome</label>
            <Input @bind-Value="Model.Nome"
                   Style="width: 100%;"
                   AutoComplete="false" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label d-block fw-semibold" style="font-size: 12px; margin-bottom: 4px;">Cnpj</label>
            <Input @bind-Value="Model.Cnpj"
                   Style="width: 100%;"
                   AutoComplete="false"
                   @oninput="HandleInput" />
        </div>
    </div>

    <div class="row g-3 mb-1 align-items-end">
        <label class="form-label d-block fw-semibold mb-3" style="font-size: 16px;">Ratings</label>
        @foreach (var rating in Model.Ratings)
        {
            <div class="row g-3 mb-1 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label d-block fw-semibold" style="font-size: 12px; margin-bottom: 4px;">Fonte</label>
                    <Select TItem="FonteOption"
                            TItemValue="int?"
                            ValueName="@(nameof(FonteOption.Valor))"
                            LabelName="@nameof(FonteOption.Descricao)"
                            Placeholder="Selecione..."
                            Style="width: 100%;"
                            @bind-Value="rating.Fonte"
                            DataSource="@rating.FonteOpcoes"
                            DisabledName="@(nameof(FonteOption.NaoDisponivel))">
                        <ItemTemplate>
                            <span>@(context.Descricao)</span>
                        </ItemTemplate>
                    </Select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label d-block fw-semibold" style="font-size: 12px; margin-bottom: 4px;">Valor</label>
                    <Select TItem="ValorOption"
                            TItemValue="int?"
                            ValueName="@(nameof(ValorOption.Valor))"
                            LabelName="@nameof(ValorOption.ValueDisplayName)"
                            Placeholder="Selecione..."
                            Mode="SelectMode.Default"
                            Style="width: 100%;"
                            DataSource="@ValorOpcoes"
                            @bind-Value="rating.Valor">
                        <ItemTemplate>
                            <span>@(context.Valor)</span>
                            <span style="color: rgba(0, 0, 0, 0.55);">@(context.Descricao)</span>
                        </ItemTemplate>
                    </Select>
                </div>
                <div class="col-12 col-md-4">
                    <Button Danger OnClick="() => RemoverRating(rating)">Remover</Button>
                </div>
            </div>
        }
    </div>

    <div class="col-12">
        <Button Type="@AntDesign.ButtonType.Dashed" OnClick="AdicionarRating" Disabled="@(TotalDeFontesDisponiveis == 0)">
            <Icon Type="plus" /> Adicionar Nova Fonte
        </Button>
    </div>

    <div class="d-flex justify-content-end">
        <Button Type="@AntDesign.ButtonType.Primary"
                OnClick="SalvarAsync"
                Disabled="@(!Model.Valido())">
            Salvar
        </Button>
    </div>
</div>
